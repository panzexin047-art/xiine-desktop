{
  "name": "xiine-desktop",
  "productName": "Xiine",
  "version": "1.0.0",
  "description": "Xiine desktop app for Mac and Windows: opens xiine.app in its own window.",
  "author": "Xiine <panzexin047@gmail.com>",
  "homepage": "https://xiine.app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.xiine.desktop",
    "productName": "Xiine",
    "copyright": "© Xiine",
    "files": ["main.js", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "artifactName": "Xiine-${os}-${arch}.${ext}",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Xiine",
      "contents": [
        { "x": 140, "y": 180 },
        { "x": 400, "y": 180, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xiine"
    }
  }
}
